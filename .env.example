# Copia este fichero a .env y cambia las contraseñas. NO subas .env a Git.
# MariaDB crea la base de datos y el usuario la primera vez que arranca
# con el volumen vacío, usando estas variables:
MYSQL_ROOT_PASSWORD=cambia_root
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=cambia_wp
# WordPress se conecta con estas (deben ser iguales que las de arriba):
WP_DB_NAME=wordpress
WP_DB_USER=wpuser
WP_DB_PASSWORD=cambia_wp
